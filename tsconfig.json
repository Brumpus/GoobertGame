{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "moduleResolution": "bundler",
    "rootDir": "./", /* Specify the base directory to resolve non-relative module names. */
    "module": "esnext", /* Specify what module management is used. */
    "target": "esnext", /* Set the JavaScript language version for emitted JavaScript and include compatible library declarations. */
    "outDir": "ts", // Necessary so Typescript doesn't try to compile already built files

	  "esModuleInterop": true, /* Emit additional JavaScript to ease support for importing CommonJS modules. This enables 'allowSyntheticDefaultImports' for type compatibility. */

    "types": [],
    "sourceMap": true, /* Create source map files for emitted JavaScript files. */
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true, /* Enable all strict type-checking options. */
    "jsx": "react", /* Specify what JSX code is generated. */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true, /* Skip type checking all .d.ts files. */
    
    "allowJs": true // To prevent the need to completely refactor longer js files
  }
}